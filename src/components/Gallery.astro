---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
import { href } from '../lib/paths';

interface Props {
  items: { image: ImageMetadata; caption: string; alt: string; studio?: string }[];
}
const { items } = Astro.props;
---

<div class="gallery">
  {
    items.map((p, i) => (
      <figure style={`--tilt: ${[-0.8, 0.6, -0.4, 0.9, -0.6, 0.4][i % 6]}deg`}>
        <Image src={p.image} alt={p.alt} widths={[320, 480, 680]} sizes="(max-width: 600px) 45vw, 360px" />
        <figcaption>
          <span>{p.caption}</span>
          {p.studio && <a href={href(`color/#${p.studio}`)}>Colour it online<Arrow /></a>}
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 3vw, 36px) clamp(14px, 2.4vw, 30px); }
  figure { margin: 0; }
  img {
    width: 100%; background: #fff; border: 2px solid var(--ink); border-radius: 4px; padding: 6px;
    transform: rotate(var(--tilt)); transition: transform .2s ease;
  }
  figure:hover img { transform: rotate(0); }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; margin-top: 12px; }
  figcaption span { font: 650 1.02rem/1.3 var(--font-display); }
  figcaption a { font-size: var(--step--1); font-weight: 700; }
  @media (max-width: 760px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
