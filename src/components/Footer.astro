---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { href } from '../lib/paths';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="brand">
      <p class="wordmark"><span class="hl hl-under">M.J. Artel</span></p>
      <p>Colouring books for ages {SITE.ages}, and for anyone who still likes to colour.</p>
    </div>
    <nav aria-label="Books">
      <h2>Books</h2>
      <ul>{books.map((b) => <li><a href={href(`${b.id}/`)}>{b.data.title}</a></li>)}</ul>
    </nav>
    <nav aria-label="Colour">
      <h2>Colour</h2>
      <ul>
        <li><a href={href('color/')}>Colouring Studio</a></li>
        <li><a href={href('free-coloring-pages/')}>Free colouring pages</a></li>
        <li><a href={href('blog/')}>Blog</a></li>
      </ul>
    </nav>
    <nav aria-label="About">
      <h2>About</h2>
      <ul>
        <li><a href={href('about/')}>About M.J. Artel</a></li>
        {SITE.contactEmail && <li><a href={href('contact/')}>Contact</a></li>}
        <li><a href={href('privacy/')}>Privacy</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} M.J. Artel. The colouring pages are free to print at home and in class.</p>
    {SITE.amazonAssociate && <p>As an Amazon Associate I earn from qualifying purchases.</p>}
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(56px, 8vw, 104px); background: var(--night); color: #fff; }
  .cols { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 32px; padding-block: 48px 28px; }
  .wordmark { margin: 0 0 .7rem; font: 800 1.6rem/1 var(--font-display); }
  .brand p:last-child { max-width: 30ch; color: #d8dde1; }
  h2 { margin: 0 0 .6rem; font: 650 1rem/1.2 var(--font-display); color: var(--yellow); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 7px 0; }
  a { color: #fff; text-decoration-color: rgb(255 255 255 / .35); }
  a:hover { color: #fff; text-decoration-color: var(--yellow); }
  .legal { padding-block: 18px 34px; border-top: 1.5px solid rgb(255 255 255 / .25); font-size: var(--step--1); color: #c3c9ce; }
  .legal p { margin: 4px 0; }
  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
</style>
