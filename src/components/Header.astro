---
import Logo from './Logo.astro';
import { href } from '../lib/paths';

const links = [
  { label: 'Books', path: '#books' },
  { label: 'Colour online', path: 'color/' },
  { label: 'Free pages', path: 'free-coloring-pages/' },
  { label: 'Blog', path: 'blog/' },
  { label: 'About', path: 'about/' },
];
const here = Astro.url.pathname;
const current = (path: string) => !path.startsWith('#') && here.startsWith(href(path));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={href('')}>
      <Logo />
      <span>M.J. Artel</span>
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {links.map((l) => <li><a href={href(l.path)} aria-current={current(l.path) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <details class="menu">
        <summary>Menu</summary>
        <ul>
          {links.map((l) => <li><a href={href(l.path)} aria-current={current(l.path) ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </details>
    </nav>
  </div>
  <div class="wood-rule"></div>
</header>

<style>
  .site-header { background: var(--paper); position: relative; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .logo {
    display: inline-flex; align-items: center; gap: 8px;
    font: 700 1.45rem/1 var(--font-display); color: var(--ink); text-decoration: none;
  }
  .links { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .links a, .menu a {
    display: block; padding: 10px 12px; border-radius: 10px;
    color: var(--ink); font-weight: 800; text-decoration: none;
  }
  .links a:hover, .menu a:hover { background: var(--cream); }
  a[aria-current='page'] { color: var(--moss-2); box-shadow: inset 0 -3px 0 var(--honey); border-radius: 10px 10px 4px 4px; }
  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none; cursor: pointer; padding: 10px 16px; border-radius: 999px;
    font-weight: 800; box-shadow: inset 0 0 0 1.5px var(--sand-2);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 220px; margin: 0; padding: 8px;
    list-style: none; background: var(--paper); border: 1px solid var(--sand); border-radius: 14px; box-shadow: var(--shadow);
  }
  @media (max-width: 760px) {
    .links { display: none; }
    .menu { display: block; }
  }
</style>
