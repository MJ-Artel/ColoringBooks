---
// A small drawn arrow for "go on" links (the fonts don't include arrows).
---

<svg class="arrow" viewBox="0 0 26 20" width="1.2em" height="0.92em" aria-hidden="true">
  <path d="M2 10.5 C8 9.4 15 9.6 22.5 10.2 M16.5 4 L23 10.2 L16.8 16.2" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>

<style>
  .arrow { display: inline-block; vertical-align: -0.12em; margin-left: .2em; transition: transform .15s ease; }
  :global(a:hover) > .arrow { transform: translateX(3px); }
</style>
