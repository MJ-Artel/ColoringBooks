---
// A book on the shelf: its cover on a patch of crayon in one of its own colours.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { href } from '../lib/paths';

interface Props { book: CollectionEntry<'books'>; level?: 'h2' | 'h3' }
const { book, level = 'h3' } = Astro.props;
const d = book.data;
const url = href(`${book.id}/`);
const Heading = level;
const pad = { wildwood: 'var(--yellow)', robot: 'var(--cyan)', cars: 'var(--orange)' }[d.key];
---

<article class="book" style={`--pad: ${pad}`}>
  <a class="cover" href={url} tabindex="-1" aria-hidden="true">
    <Image src={d.cover} alt="" widths={[280, 420, 560]} sizes="(max-width: 760px) 78vw, 330px" />
  </a>
  <Heading class="title"><a href={url}>{d.title}</a></Heading>
  <p class="hook">{d.hook}</p>
  <p class="facts">Ages {d.ages} · {d.pageCount} pages · {d.pictures} pictures</p>
  <a class="more" href={url}>See inside<Arrow /></a>
</article>

<style>
  .book { display: flex; flex-direction: column; }
  .cover { position: relative; z-index: 0; display: block; margin: 0 18px 26px 0; }
  .cover::before {
    content: ""; position: absolute; z-index: -1; inset: 0; border-radius: 8px;
    background: var(--crayon), var(--pad);
    transform: translate(16px, 16px) rotate(1.6deg);
    transition: transform .25s cubic-bezier(.3, .7, .4, 1.3);
  }
  .cover:hover::before { transform: translate(10px, 12px) rotate(-1deg); }
  .cover img { width: 100%; aspect-ratio: 1; object-fit: cover; border: var(--line) solid var(--ink); border-radius: 8px; }
  .title { margin: 0 0 .25em; font-size: var(--step-2); }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  .hook { margin: 0 0 .4em; }
  .facts { margin: 0 0 .7em; color: var(--ink-2); font-size: var(--step--1); }
  .more { margin-top: auto; align-self: flex-start; font: 650 1.02rem/1.3 var(--font-display); }
</style>
