---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const d = article.data;
const url = href(`blog/${article.id}/`);
const date = d.pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<article class="post card">
  <a href={url} tabindex="-1" aria-hidden="true"><Image src={d.hero} alt="" widths={[360, 540, 720]} sizes="(max-width: 760px) 92vw, 360px" /></a>
  <div class="body">
    <h3><a href={url}>{d.title}</a></h3>
    <p>{d.description}</p>
    <p class="date"><time datetime={d.pubDate.toISOString()}>{date}</time></p>
  </div>
</article>

<style>
  .post { overflow: hidden; display: flex; flex-direction: column; }
  img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; background: #fff; }
  .body { padding: 16px 20px 20px; }
  h3 { font-size: var(--step-1); margin-bottom: .4em; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0 0 .5em; color: var(--muted); font-size: var(--step--1); }
  .date { font-weight: 700; }
</style>
