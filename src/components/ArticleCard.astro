---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const d = article.data;
const url = href(`blog/${article.id}/`);
---

<article class="post">
  <a class="pic" href={url} tabindex="-1" aria-hidden="true">
    <Image src={d.hero} alt="" widths={[360, 540, 720]} sizes="(max-width: 760px) 92vw, 360px" />
  </a>
  <h3><a href={url}>{d.title}</a></h3>
  <p>{d.description}</p>
</article>

<style>
  .post { display: flex; flex-direction: column; }
  .pic { display: block; margin-bottom: 14px; }
  .pic img {
    width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #fff;
    border: var(--line) solid var(--ink); border-radius: 8px; transition: transform .2s ease;
  }
  .pic:hover img { transform: rotate(-1deg); }
  h3 { margin-bottom: .35em; font-size: var(--step-1); line-height: 1.2; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  p { margin: 0; color: var(--ink-2); font-size: var(--step--1); }
</style>
