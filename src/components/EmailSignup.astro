---
// Email sign-up for the free pack (MailerLite). Until the MailerLite form is set in src/data/site.ts,
// visitors get the plain download instead.
import { SITE, mailerliteAction } from '../data/site';
import { href } from '../lib/paths';

interface Props { button?: string }
const { button = 'Send me the free pack' } = Astro.props;
const action = mailerliteAction();
---

{
  action ? (
    <form class="signup" action={action} method="post" data-signup>
      <label class="sr-only" for="signup-email">Your email address</label>
      <div class="row">
        <input id="signup-email" type="email" name="fields[email]" autocomplete="email" placeholder="you@example.com" required />
        <button class="btn btn-buy" type="submit">{button}</button>
      </div>
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>Yes, email me the free pack and occasional new pages from M.J. Artel. I’m a parent, carer or teacher (18+). Unsubscribe any time.</span>
      </label>
      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />
      <p class="status" role="status" aria-live="polite" hidden />
    </form>
  ) : (
    <div class="download">
      <a class="btn btn-buy" href={href(SITE.freePack)} download>Download the free pack (PDF)</a>
      <p class="muted">Six pages, free for personal and classroom use.</p>
    </div>
  )
}

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.status')!;
      const button = form.querySelector<HTMLButtonElement>('button')!;
      button.disabled = true;
      status.hidden = false;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) throw new Error('rejected');
        form.reset();
        status.textContent = 'Thank you! Check your inbox for an email to confirm, then your pack is on its way.';
      } catch {
        status.textContent = 'Sorry, that didn’t go through. Please check the address and try again.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .signup { display: grid; gap: 10px; max-width: 34rem; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  input[type='email'] {
    flex: 1 1 14rem; min-height: 48px; padding: 0 16px; border-radius: 999px;
    border: 1.5px solid var(--sand-2); background: #fff; font: inherit;
  }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: var(--step--1); }
  .consent input { margin-top: 4px; width: 18px; height: 18px; accent-color: var(--moss); }
  .status { margin: 0; font-weight: 700; }
  .download p { margin: 8px 0 0; font-size: var(--step--1); }
</style>
