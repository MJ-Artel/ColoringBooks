---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { href } from '../lib/paths';
import defaultCard from '../../assets/wildwood-cover.jpg';
import displayFont from '../../color/fonts/shantell-800.woff2?url';
import textFont from '../../color/fonts/andika-400.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = defaultCard,
  imageAlt = 'The Wildwood Games colouring book cover: a bear, wolf, eagle and fox on a winners’ podium',
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const card = await getImage({ src: image, width: 1200, format: 'jpg' });
const cardUrl = new URL(card.src, Astro.site).toString();
const json = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    {schema.map((data) => <script type="application/ld+json" set:html={json(data)} />)}
    {
      SITE.cloudflareBeacon && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cloudflareBeacon })}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
