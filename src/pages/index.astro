---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import BookCard from '../components/BookCard.astro';
import ColourMe from '../components/ColourMe.astro';
import StudioBand from '../components/StudioBand.astro';
import FreePack from '../components/FreePack.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Arrow from '../components/Arrow.astro';
import { SITE } from '../data/site';
import { href } from '../lib/paths';
import { author } from '../lib/schema';
import { publishedArticles } from '../lib/articles';
import cover from '../../assets/wildwood-cover.jpg';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const articles = (await publishedArticles()).slice(0, 3);
const site = Astro.site;

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL(href(''), site).toString(), description: SITE.description },
  { '@context': 'https://schema.org', ...author(site), description: 'Independent creator of story-led colouring books for children.' },
];
---

<Base title="M.J. Artel · Story-Led Colouring Books for Kids 4–10" description={SITE.description} schema={schema}>
  <section class="hero">
    <div class="wrap grid">
      <div class="head">
        <h1>Who will you <span class="hl">cheer</span> for?</h1>
        <p class="lede">
          In <a href={href('wildwood-games-coloring-book/')}>The Wildwood Games</a>, the Foxes, Bears, Wolves and Eagles
          compete for forest fame while Snappy Snapsalot, a snapping turtle, referees. Each of its 37 pictures comes with
          a page of story.
        </p>
      </div>
      <div class="pic">
        <ColourMe
          page="wildwood-29"
          width={1166}
          height={1200}
          start="assets/hero/wildwood-29-start.webp"
          alt="Fox soccer, a page from The Wildwood Games: a fox in a football shirt kicks a ball, half coloured in with orange and blue crayon."
          hint="Finish the fox: pick a crayon, then tap the picture."
        />
      </div>
      <div class="buy-area">
        <div class="buy-row">
          <a class="mini-cover" href={href('wildwood-games-coloring-book/')} tabindex="-1" aria-hidden="true">
            <Image src={cover} alt="" width={96} densities={[1, 2]} loading="eager" />
          </a>
          <BuyButton book="wildwood" label="Buy The Wildwood Games" />
        </div>
        <p class="ages">For ages {SITE.ages}, and any age can enjoy it.</p>
        <p class="others">
          More of a robots or cars family? Try the <a href={href('robot-coloring-book/')}>Robot Coloring Book</a> or
          the <a href={href('cars-coloring-book/')}>Cars Coloring Book</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="books" class="section" aria-labelledby="books-heading">
    <div class="wrap">
      <h2 id="books-heading" class="shelf-title">Animals, robots or <span class="hl" style="--hl: var(--orange)">cars?</span></h2>
      <div class="books">{books.map((b) => <BookCard book={b} />)}</div>
    </div>
  </section>

  <StudioBand />

  <section class="section">
    <div class="wrap"><FreePack /></div>
  </section>

  {
    articles.length > 0 && (
      <section class="section-tight" aria-labelledby="blog-heading">
        <div class="wrap">
          <div class="posts-head">
            <h2 id="blog-heading">From the blog</h2>
            <a href={href('blog/')}>All articles<Arrow /></a>
          </div>
          <div class="posts">{articles.map((a) => <ArticleCard article={a} />)}</div>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="wrap note">
      <h2>A note from M.J. Artel</h2>
      <div>
        <p>
          I make colouring books where the pictures belong to a story: a snapping turtle who referees the forest games,
          a tiny robot who loses his favourite colouring book. If one of them has kept someone happily busy, a short
          review on Amazon helps other families find it.
        </p>
        <p class="sig"><span class="hl">M.J. Artel</span></p>
        <a href={href('about/')}>More about M.J. Artel<Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(24px, 5vw, 64px) clamp(8px, 2vw, 24px); }
  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "head pic" "buy pic";
    grid-template-rows: auto 1fr; column-gap: clamp(28px, 5vw, 72px);
  }
  .head { grid-area: head; align-self: end; padding-top: clamp(0px, 4vw, 56px); }
  .pic { grid-area: pic; }
  .buy-area { grid-area: buy; }
  h1 { max-width: 11ch; margin-bottom: .35em; }
  .lede { max-width: 34ch; margin-bottom: 28px; }
  .buy-row { display: flex; align-items: flex-start; gap: 18px; }
  .mini-cover img { width: 96px; border: 2px solid var(--ink); border-radius: 6px; transform: rotate(-3deg); }
  .ages { margin: 20px 0 6px; font-weight: 700; }
  .others { margin: 0; color: var(--ink-2); max-width: 40ch; }
  .shelf-title { margin-bottom: clamp(28px, 4vw, 48px); }
  .books { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 4vw, 56px); }
  .posts-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: 28px; }
  .posts-head h2 { margin: 0; }
  .posts-head a { font: 650 1.05rem/1.3 var(--font-display); }
  .posts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 36px); }
  .note {
    display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(16px, 4vw, 56px);
    padding-top: clamp(32px, 5vw, 56px); border-top: var(--line) solid var(--ink);
  }
  .note p { max-width: 54ch; font-size: var(--step-1); }
  .sig { margin: .2em 0 .8em; font: 800 1.6rem/1 var(--font-display); }
  .note a { font: 650 1.02rem/1.3 var(--font-display); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "pic" "buy"; grid-template-rows: auto; }
    .head { padding-top: 0; }
    .lede { margin-bottom: 20px; }
    .buy-area { margin-top: 36px; }
    .mini-cover img { width: 70px; }
    .books { grid-template-columns: minmax(0, 1fr); max-width: 440px; }
    .posts { grid-template-columns: minmax(0, 1fr); max-width: 520px; }
    .note { grid-template-columns: minmax(0, 1fr); }
  }
</style>
