---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BuyButton from '../../components/BuyButton.astro';
import Faq from '../../components/Faq.astro';
import FreePack from '../../components/FreePack.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { href } from '../../lib/paths';
import { author, breadcrumbs, faqPage } from '../../lib/schema';
import { publishedArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const d = article.data;
const { Content } = await render(article);
const books = await getCollection('books');
const book = books.find((b) => b.data.key === d.book)!;
const related = (await publishedArticles()).filter((a) => a.id !== article.id).slice(0, 3);
const trail = [{ name: 'Blog', path: 'blog/' }, { name: d.title, path: `blog/${article.id}/` }];
const hero = await getImage({ src: d.hero, width: 1200, format: 'jpg' });
const site = Astro.site;
const date = (value: Date) => value.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: new URL(hero.src, site).toString(),
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: author(site),
    publisher: author(site),
    mainEntityOfPage: new URL(href(`blog/${article.id}/`), site).toString(),
  },
  breadcrumbs(trail, site),
  ...faqPage(d.faq),
];
---

<Base title={`${d.seoTitle ?? d.title} | M.J. Artel`} description={d.description} image={d.hero} imageAlt={d.heroAlt} type="article" schema={schema}>
  <article class="section-tight">
    <div class="wrap">
      <Breadcrumbs trail={trail} />
      <header class="head">
        <h1>{d.title}</h1>
        <p class="meta">
          By <a href={href('about/')}>M.J. Artel</a> · <time datetime={d.pubDate.toISOString()}>{date(d.pubDate)}</time>
          {d.updatedDate && <> · updated <time datetime={d.updatedDate.toISOString()}>{date(d.updatedDate)}</time></>}
        </p>
      </header>
      <div class="layout">
        <div class="prose">
          <Image class="hero" src={d.hero} alt={d.heroAlt} widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 720px" loading="eager" />
          <Content />
          <Faq items={d.faq} heading="Questions people ask" />
        </div>
        <aside class="side">
          <div class="promo">
            <Image src={book.data.cover} alt="" width={220} />
            <p class="from">This article goes with</p>
            <h2><a href={href(`${book.id}/`)}>{book.data.title}</a></h2>
            <p>{book.data.hook}</p>
            <BuyButton book={book.data.key} stores={false} />
            <a class="look" href={href(`${book.id}/`)}>See inside the book</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section class="section-tight">
    <div class="wrap"><FreePack /></div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight" aria-labelledby="related-heading">
        <div class="wrap">
          <h2 id="related-heading">More ideas</h2>
          <div class="posts">{related.map((a) => <ArticleCard article={a} />)}</div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .head { max-width: 46rem; }
  .head h1 { font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.2rem); }
  .meta { color: var(--ink-2); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: clamp(24px, 5vw, 56px); align-items: start; }
  .prose :global(.hero) { margin-top: 0; }
  .side { position: sticky; top: 24px; }
  .promo { padding: 22px; border: var(--line) solid var(--ink); border-radius: 14px; background: #fff; }
  .promo img { margin: 0 0 14px; border: 2px solid var(--ink); border-radius: 6px; transform: rotate(-2deg); }
  .from { margin: 0 0 .2em; font-size: var(--step--1); color: var(--ink-2); }
  .promo h2 { font-size: var(--step-2); }
  .promo h2 a { text-decoration: none; }
  .promo h2 a:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  .promo p { color: var(--ink-2); }
  .look { display: inline-block; margin-top: 14px; font: 650 1rem/1.3 var(--font-display); }
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: clamp(28px, 4vw, 44px) clamp(20px, 3vw, 36px); margin-top: 28px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; max-width: 420px; }
  }
</style>
